generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://neondb_owner:npg_Q97zeiyTZrJs@ep-damp-salad-acoh5y39-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
}

model User {
  id    Int     @id @default(autoincrement())
  name  String
  email String  @unique
  phone String?
  products Product[]
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById Int
}