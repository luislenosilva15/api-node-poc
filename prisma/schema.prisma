model User {
  id       Int       @id @default(autoincrement())
  name     String
  email    String    @unique
  phone    String?
  password String    @default("$2a$10$8K1p/a0dL1LXMIgoEDFrwOfMQHzXK/H5Zv1v0pIj5.U0Gzp8LrGaC")
